# Supabase URL (hosted project URL or local API URL printed by `supabase start`)
SUPABASE_URL=http://127.0.0.1:54321

# Backend-only Supabase secret/server key. Never add this value to frontend/.env.local or source control.
SUPABASE_SECRET_KEY=

# Maximum wait for each local Ollama HTTP request (seconds). A cold model load
# or a multi-step tool call can take several minutes on a laptop.
OLLAMA_TIMEOUT_SECONDS=600
